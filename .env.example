# Copy this file to .env for local development. Never commit .env.
# The API reads .env from the repository root when it starts.
# Every value is optional locally: the defaults target the local Supabase
# that `npm run db:start` runs.

# Port the API listens on.
PORT=3000

# PostgreSQL connection string. Required when NODE_ENV=production.
# The local default is the Supabase CLI's fixed development database.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# PostgreSQL the API tests use. Defaults to the same local database.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project URL and keys. Required when NODE_ENV=production. Locally the
# npm scripts (dev, test, seed, test:e2e) read all three from the running local
# stack (`npx supabase status -o env`), so leave them unset; a value set here or
# in the environment wins. There is no default key in the source.
# SUPABASE_URL=http://127.0.0.1:54321
# The publishable key lets the API call the public Auth endpoints (sign-in).
# SUPABASE_PUBLISHABLE_KEY=
# The secret key creates a Member's account at sign-up and confirms its email once the emailed
# code is accepted, so the running API needs it (a hosted API sets it as a secret, never in source).
# The seed script and the tests use it too.
# SUPABASE_SECRET_KEY=

# The seed script's Librarian. Required in production; the local defaults are
# librarian@libras.test with a demo password.
# SEED_LIBRARIAN_EMAIL=
# SEED_LIBRARIAN_PASSWORD=
# SEED_LIBRARIAN_NAME=

# ---------------------------------------------------------------------------
# Hosted deployment (Supabase, Render, Brevo). Do NOT put these in .env: .env is
# read by the local scripts and tests, which must keep using the local Supabase.
# `npm run setup:hosted` writes them to .env.hosted (gitignored), and the same
# names are the environment variables of the Render service (see render.yaml).
# ---------------------------------------------------------------------------
# NODE_ENV=production
# DATABASE_URL=            Supabase session pooler string, password filled in
# SUPABASE_URL=            https://<project id>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=     the Render service needs it: Member sign-up creates the account and confirms its email
# BREVO_API_KEY=           the email service; required in production
# EMAIL_FROM_ADDRESS=      a sender verified in Brevo; required in production
# EMAIL_FROM_NAME=LIBRAS
# CORS_ALLOWED_ORIGINS=    comma separated origins of hosted web pages that call the API (none by default)
# DATABASE_CA_CERT=        optional PEM CA certificate of the Supabase database, to verify its TLS certificate
# EXPO_PUBLIC_API_URL=     the hosted API address (https), baked into the APK by `npm run build:apk:hosted`
