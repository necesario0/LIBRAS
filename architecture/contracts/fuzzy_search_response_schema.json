{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libras.umak.edu.ph/schemas/fuzzy_search_response.json",
  "title": "FuzzyCatalogSearchResponseCertificate",
  "description": "Deterministic output certificate returned by the Bounded Trie Levenshtein Search Engine.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "NO_MATCHES", "EMPTY_QUERY", "DEGRADED"],
      "description": "Status code of algorithmic execution."
    },
    "query_executed": {
      "type": "string",
      "description": "Sanitized and normalized query string evaluated."
    },
    "execution_time_ms": {
      "type": "number",
      "description": "Core algorithm execution latency in milliseconds (SLA < 35.0 ms)."
    },
    "nodes_visited": {
      "type": "integer",
      "minimum": 0,
      "description": "Total Trie graph nodes evaluated during traversal."
    },
    "branches_pruned": {
      "type": "integer",
      "minimum": 0,
      "description": "Total Trie subtrees pruned via branch-and-bound cutoffs."
    },
    "total_matches": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of qualifying matches returned."
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "matched_token": { "type": "string" },
          "title": { "type": "string" },
          "edit_distance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "similarity_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 2.0
          },
          "metadata": {
            "type": "object",
            "properties": {
              "book_id": { "type": "string" },
              "call_number": { "type": "string" },
              "isbn": { "type": "string" },
              "popularity_score": { "type": "number" }
            }
          }
        },
        "required": ["matched_token", "title", "edit_distance", "similarity_score"]
      }
    }
  },
  "required": ["status", "query_executed", "execution_time_ms", "matches"],
  "additionalProperties": false
}
