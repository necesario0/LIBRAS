{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libras.umak.edu.ph/schemas/hold_dispatch_response.json",
  "title": "HoldDispatchAllocationCertificate",
  "description": "Deterministic allocation certificate returned by Role-Weighted Min-Heap Dispatcher.",
  "type": "object",
  "properties": {
    "certificate_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique cryptographic receipt for the hold allocation event."
    },
    "allocation_status": {
      "type": "string",
      "enum": ["ALLOCATED_TO_HOLD", "NO_ACTIVE_HOLDS_AVAILABLE"],
      "description": "Status of the physical copy check-in allocation."
    },
    "accession_number": {
      "type": "string",
      "description": "Scanned physical accession number."
    },
    "allocated_patron": {
      "type": ["object", "null"],
      "properties": {
        "patron_id": { "type": "string" },
        "full_name": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["Faculty", "NTP", "Student", "Visitor"]
        },
        "email": { "type": "string", "format": "email" },
        "priority_score": { "type": "integer" },
        "claim_deadline_timestamp": {
          "type": "integer",
          "description": "Epoch ms marking expiration of the 48-hour pickup window."
        }
      },
      "required": ["patron_id", "role", "claim_deadline_timestamp"]
    },
    "queue_remaining_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of remaining unallocated holds in title's Min-Heap."
    },
    "resolution_latency_ms": {
      "type": "number",
      "description": "Processing duration in milliseconds (SLA < 10.0 ms)."
    }
  },
  "required": ["certificate_id", "allocation_status", "accession_number", "resolution_latency_ms"],
  "additionalProperties": false
}
