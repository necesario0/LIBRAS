{
  "name": "libras-algorithm-benchmarks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototype benchmark code for the LIBRAS algorithm choices (Bounded Trie Levenshtein Search and Role-Weighted Min-Heap Dispatcher)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "bench:search": "node --expose-gc --max-old-space-size=8192 src/bench-search.ts",
    "bench:heap": "node --expose-gc --max-old-space-size=8192 src/bench-heap.ts",
    "bench:claims": "node --expose-gc --max-old-space-size=8192 src/verify-claims.ts",
    "bench:worstcase": "node src/verify-worst-case.ts",
    "bench:h2h": "node --expose-gc --max-old-space-size=8192 src/bench-head-to-head.ts",
    "bench:pg": "node --expose-gc src/bench-pg.ts",
    "matrix": "node src/decision-matrix.ts",
    "bench": "npm run bench:search && npm run bench:heap && npm run bench:claims"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
